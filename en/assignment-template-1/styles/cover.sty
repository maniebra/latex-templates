\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cover}[2026/08/03 Neobrutalist assignment cover]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\usetikzlibrary{shapes.geometric, calc}

\newcommand{\makecover}{%
\begin{titlepage}
    \begin{tikzpicture}[remember picture, overlay]

        % Hexagonal grid, clipped to the page
        \begin{scope}
            \clip (current page.south west) rectangle (current page.north east);
            \foreach \x in {0,...,35} {
                    \foreach \y in {0,...,40} {
                            \pgfmathsetmacro{\yoffset}{0.866*\y + mod(\x,2)*0.433}
                            \node[regular polygon, regular polygon sides=6, minimum size=1cm, draw=hairline, thin, outer sep=0pt]
                            at ([xshift=0.75*\x cm, yshift=\yoffset cm]current page.south west) {};
                        }
                }
        \end{scope}

        % Top border
        \fill[ink] ([yshift=-2cm]current page.north west) rectangle (current page.north east);

        % Title
        \node[anchor=north west, xshift=1.5cm, yshift=-3cm] at (current page.north west) {
            \begin{minipage}{0.62\textwidth}
                \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
                {\pixelfont\fontsize{40}{40}\selectfont\baselineskip=54pt\relax
                \coursename\par} \vspace{1cm}
                {\fontsize{24}{30}\selectfont \textbf{\hwtitle}}
            \end{minipage}
        };

        % Decorative pixel glyph
        \node[anchor=north east, xshift=-1.5cm, yshift=-3.5cm] at (current page.north east) {
            {\pixelfont\fontsize{120}{120}\selectfont >}
        };

        % Vertical rule
        \fill[ink] ([xshift=1.5cm, yshift=2cm]current page.south west) rectangle ([xshift=1.7cm, yshift=12cm]current page.south west);

        % Lecturers and semester
        \node[anchor=south west, xshift=2.2cm, yshift=2cm] at (current page.south west) {
            \begin{minipage}{10cm}
                \begin{flushleft}
                    {\Large Lecturers: \\ \lecturers} \\[0.8cm]
                    {\small \semester}
                \end{flushleft}
            \end{minipage}
        };

        % Logo and department
        \node[anchor=south east, xshift=-1.5cm, yshift=2cm] at (current page.south east) {
            \begin{minipage}{8cm}
                \begin{flushright}
                    {\includegraphics[width=4cm]{\hwlogo}}\\[0.4cm]
                    {\pixelfont\fontsize{10}{12}\selectfont \department}
                \end{flushright}
            \end{minipage}
        };

        % Bottom border
        \fill[ink] (current page.south west) rectangle ([yshift=1cm]current page.south east);

    \end{tikzpicture}
\end{titlepage}
}

\endinput
