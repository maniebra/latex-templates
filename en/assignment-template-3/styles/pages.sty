\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pages}[2026/08/03 Full-bleed page furniture]

\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage{styles/grid}

\setlength{\headheight}{18pt}
\pagecolor{paper}
\color{ink}

% Full-bleed black footer bar. The folio is reversed out of it, set large and
% flush to the outer edge; the running title sits at the inner edge.
\newcommand{\footerbar}{%
    \begin{tikzpicture}[remember picture, overlay]
        \fill[ink] (current page.south west) rectangle
                   ([yshift=15mm]current page.south east);

            \node[anchor=west, text=paper, xshift=15mm, yshift=7.5mm]
            at (current page.south west) {\lscsm{\semester}};
        \node[anchor=east, text=paper, xshift=-15mm, yshift=7.5mm]
            at (current page.south east) {{\postfont\Large\thepage}};
        \node[text=paper, yshift=7.5mm] at (current page.south)
            {\lscsm{\hwtitle}};
    \end{tikzpicture}%
}

% Head: a heavy bar with the course name under it, nothing else.
\renewcommand{\headrule}{{\color{ink}\hrule height 3.6pt}}

\fancypagestyle{gridstyle}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{3.6pt}
    \renewcommand{\footrulewidth}{0pt}
    \fancyhead[L]{\lscsm{\coursename}}
    \fancyhead[R]{\lscsm{\coursecode\ HW\hwnumber}}
    \fancyfoot[C]{\footerbar}
}

\fancypagestyle{plain}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
    \fancyfoot[C]{\footerbar}
}

\pagestyle{gridstyle}

\endinput
