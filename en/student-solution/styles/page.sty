\ProvidesPackage{styles/page}[2026/08/03 Page geometry, headers, footers]
% A4, because this gets uploaded and printed by someone else.

\RequirePackage[
  a4paper,
  inner       = 26mm,
  outer       = 26mm,
  top         = 24mm,
  bottom      = 24mm,
  headheight  = 14pt,
  headsep     = 7mm,
  footskip    = 12mm,
]{geometry}

\RequirePackage{fancyhdr}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\newcommand{\sol@hairline}{\textcolor{rule}{\rule{\linewidth}{0.4pt}}}

\newcommand{\sol@runhead}[1]{%
  \textcolor{inkfaint}{\uimed\fontsize{7.4}{7.4}\selectfont\tracked[80]{\MakeUppercase{#1}}}}
\newcommand{\sol@folio}[1]{%
  \textcolor{inkmuted}{\uisemi\fontsize{8.4}{8.4}\selectfont #1}}

\fancypagestyle{solution}{%
  \fancyhf{}
  \fancyhead[L]{\sol@runhead{\solShortTitle}}
  \fancyhead[R]{\sol@runhead{\solStudent\ · \solStudentID}}
  \fancyhead[C]{\raisebox{-6pt}[0pt][0pt]{\makebox[\linewidth]{\sol@hairline}}}
  \fancyfoot[C]{\sol@folio{\thepage}}
}

\fancypagestyle{bare}{\fancyhf{}}

\pagestyle{solution}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.62\baselineskip}
\linespread{1.15}

\widowpenalty=10000
\clubpenalty=10000

\RequirePackage[
  colorlinks = true,
  linkcolor  = accent,
  citecolor  = accent,
  urlcolor   = accent,
  linktoc    = all,
  bookmarksnumbered = true,
  pdfborder  = {0 0 0},
]{hyperref}
\RequirePackage{bookmark}
\urlstyle{same}
