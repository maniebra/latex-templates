\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{checklist}[2026/08/03 Neobrutalist checklist]

\RequirePackage{enumitem}
\RequirePackage{tikz}

% 1. Draw the Unchecked Box (Thick border, white center, hard shadow)
\newcommand{\neoboxempty}{%
    \begin{tikzpicture}[baseline=-0.2ex, scale=1.3]
        % Shadow
        \fill[ink] (0.15ex, -0.15ex) rectangle (0.95ex, 0.65ex);
        % Main Box
        \draw[ink, fill=paper, line width=1pt] (0,0) rectangle (0.8ex, 0.8ex);
    \end{tikzpicture}%
}

% 2. Draw the Checked Box (Inverted: solid black with white X)
\newcommand{\neoboxcheck}{%
    \begin{tikzpicture}[baseline=-0.2ex, scale=1.3]
        % Shadow
        \fill[ink] (0.15ex, -0.15ex) rectangle (0.95ex, 0.65ex);
        % Main Box
        \draw[ink, fill=ink, line width=1pt] (0,0) rectangle (0.8ex, 0.8ex);
        % The White "X"
        \draw[paper, line width=0.8pt] (0.15ex, 0.15ex) -- (0.65ex, 0.65ex);
        \draw[paper, line width=0.8pt] (0.15ex, 0.65ex) -- (0.65ex, 0.15ex);
    \end{tikzpicture}%
}

% 3. Define the Environment
% We use enumitem to create a robust custom itemize environment
\newlist{neochecklist}{itemize}{1}
\setlist[neochecklist]{
    label=\neoboxempty,
    leftmargin=*,
    itemsep=0.8ex,     % Spacing between items
    parsep=0pt,
    topsep=1.5ex
}

% 4. Quick Command for Checked Items
% Use \item for an empty box, and \citem for a checked box
\newcommand{\citem}{\item[\neoboxcheck]}

\endinput
