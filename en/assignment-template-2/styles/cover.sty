\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cover}[2026/08/03 Browser-window exam cover]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{fontawesome5}
\RequirePackage{adjustbox}
\usetikzlibrary{calc}

\newcommand{\makecover}{%
\begin{tikzpicture}[remember picture, overlay]

    % Window chrome: dark page, white paper inside it
    \fill[ink] (current page.north west) rectangle (current page.south east);
    \fill[paper] ($(current page.north west) - (-0.2,1.5)$) rectangle ($(current page.south east) + (-0.4,0.5)$);

    % Title bar: course name and window buttons
    \begin{scope}
        \node[anchor=west, text=paper] at ($(current page.north west) + (0.6,-0.75)$) {\adjustbox{max width=12cm}{\pixelfont\fontsize{14}{16}\selectfont \coursename}};
        \node[text=paper] at ($(current page.north east) + (-1,-0.75)$) {\fontsize{20}{20}\selectfont X};
        \node[text=paper] at ($(current page.north east) + (-2,-0.75)$) {\pixelfont\fontsize{16}{20}\selectfont \faIcon[regular]{square}};
        \node[text=paper] at ($(current page.north east) + (-3,-0.75)$) {\pixelfont\fontsize{20}{20}\selectfont \_};
    \end{scope}

    % Address bar
    \begin{scope}
        \fill[ink] ($(current page.north west) + (0.2,-3.5)$) rectangle ($(current page.north east) + (-0.4, -3.6)$);
        \fill[paper,line width=2,draw=ink] ($(current page.north west) + (0.6,-1.8)$) rectangle ($(current page.north east) + (-0.8, -3.2)$);
        \fill[ink,line width=2,draw=ink] ($(current page.north west) + (0.6,-1.8)$) rectangle ($(current page.north west) + (2, -3.2)$);
        \node[text=paper] at ($(current page.north west) + (1.33,-2.45)$) {\fontsize{20}{20}\selectfont\faIcon[regular]{search}};
        \node[anchor=west, text=ink] at ($(current page.north west) + (2.4,-2.45)$) {\pixelfont\fontsize{12}{14}\selectfont Search};
    \end{scope}

    % Course name banner
    \begin{scope}
        \fill[ink] ($(current page.north west) + (0.2,-3.5)$) rectangle ($(current page.north east) + (-0.4, -6.2)$);
        \node[text=paper] at ($(current page.north west) + (10.5,-5)$) {\adjustbox{max width=17cm}{\pixelfont\fontsize{32}{36}\selectfont \coursename}};
    \end{scope}

    % University, department, semester and logo
    \begin{scope}
        \node at ($(current page.north west) + (2.5,-8.4)$) {\includegraphics[width=3.8cm]{\hwlogo}};
        \node[anchor=west, text=ink] at ($(current page.north west) + (5,-7.5)$) {\adjustbox{max width=11cm}{\pixelfont\fontsize{14}{16}\selectfont \university{} / \department}};
        \node[anchor=west, text=ink] at ($(current page.north west) + (5,-9)$) {\pixelfont\fontsize{12}{14}\selectfont \semester};
        \node[text=ink] at ($(current page.north east) + (-1.8,-9)$) {\fontsize{20}{20}\selectfont\faIcon[regular]{university} \faIcon[regular]{calendar}};
    \end{scope}

    % Exam title banner
    \begin{scope}
        \fill[ink] ($(current page.north west) + (0.2,-10.6)$) rectangle ($(current page.north east) + (-0.4, -16)$);
        \node[text=paper] at ($(current page.north west) + (10.5,-13.25)$) {\adjustbox{max width=18cm}{\pixelfont\fontsize{40}{44}\selectfont \hwtitle}};
    \end{scope}

    % Lecturers
    \node[text=ink] at ($(current page.north west) + (10.5,-21)$) {\pixelfont\fontsize{16}{18}\selectfont \lecturers};

\end{tikzpicture}
\thispagestyle{empty}
\newpage
\setcounter{page}{1}
}

\endinput
