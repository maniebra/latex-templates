\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{grid}[2026/08/03 Bars, rules, and blocks shared by the styles]

\RequirePackage{tikz}
\usetikzlibrary{calc}

% Three rule weights, and that is the whole vocabulary.
\DeclareRobustCommand{\heavybar}[1][\linewidth]{%
    \par\noindent{\color{ink}\rule{#1}{3.6pt}}\par}
\DeclareRobustCommand{\midbar}[1][\linewidth]{%
    \par\noindent{\color{ink}\rule{#1}{1.4pt}}\par}
\DeclareRobustCommand{\hairbar}[1][\linewidth]{%
    \par\noindent{\color{mid}\rule{#1}{0.5pt}}\par}

% Reversed-out label block. The only "ornament" the template owns.
\DeclareRobustCommand{\block}[1]{%
    \begingroup\setlength{\fboxsep}{2.6mm}%
    \colorbox{ink}{\color{paper}\lscsm{#1}}\endgroup}

% The same block, outlined instead of filled.
\DeclareRobustCommand{\outlineblock}[1]{%
    \begingroup\setlength{\fboxsep}{2.4mm}\setlength{\fboxrule}{1.4pt}%
    \fcolorbox{ink}{paper}{\color{ink}\lscsm{#1}}\endgroup}

\endinput
