\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cover}[2026/08/03 Poster title page]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{adjustbox}
\RequirePackage{styles/grid}
\usetikzlibrary{calc}

% One cell of the metadata grid: label over value, both flush left.
% #1/#2 are the offsets from the top-left page corner.
\newcommand{\covercell}[4]{%
    \node[anchor=north east, text=mid, font=\scriptsize]
        at ([xshift=-#1, yshift=#2]current page.north east) {\lscsm{#3}};
    \node[anchor=north east, text=ink]
        at ([xshift=-#1, yshift=#2-6mm]current page.north east)
        {\rl{\headfont\normalsize #4}};
}

\newcommand{\makecover}{%
\begin{titlepage}
\thispagestyle{empty}
\begin{tikzpicture}[remember picture, overlay]

    % ── Masthead bar, full bleed ───────────────────────────────────────
    \fill[ink] (current page.north west) rectangle
               ([yshift=-2.2cm]current page.north east);
    \node[anchor=east, text=paper, xshift=-15mm, yshift=-1.1cm]
        at (current page.north east) {\lsc{\university}};
    \node[anchor=west, text=paper, xshift=15mm, yshift=-1.1cm]
        at (current page.north west) {\lscsm{\department}};

    % ── Assignment numeral and logo, centred on one line ───────────────
    % Persian digits carry a descender, so these align on their middles,
    % not on a baseline the \hwpostnum glyphs would hang below.
    \node[anchor=west, text=ink, inner sep=0pt,
          font=\postfont\fontsize{150}{150}\selectfont]
        at ([xshift=15mm, yshift=-21.4cm]current page.north west)
        {\hwpostnum{\two@digits{\hwnumber}}};
    \node[anchor=east, inner sep=0pt]
        at ([xshift=-15mm, yshift=-21.4cm]current page.north east)
        {\includegraphics[height=38mm]{\hwlogo}};

    % ── Title block, flush left on the grid ────────────────────────────
    \node[anchor=north east, xshift=-15mm, yshift=-3.6cm]
        at (current page.north east)
        {\lscsm{\lr{\coursecode} / تمرین \hwpostnum{\hwnumber}}};

    \node[anchor=north east, xshift=-15mm, yshift=-4.6cm, text width=13cm,
          align=right]
        at (current page.north east)
        {\rl{\postfont\fontsize{52}{54}\selectfont \hwtitle}};

    \node[anchor=north east, xshift=-15mm, yshift=-9.6cm, text width=13cm,
          align=right]
        at (current page.north east)
        {\rl{\thinfont\fontsize{22}{26}\selectfont \coursename}};

    \fill[ink] ([xshift=15mm, yshift=-11.4cm]current page.north west)
        rectangle ([xshift=-15mm, yshift=-11.76cm]current page.north east);

    % ── Metadata grid ──────────────────────────────────────────────────
    \covercell{15mm}{-12.4cm}{نیم‌سال}{\semester}
    \covercell{65mm}{-12.4cm}{مهلت تحویل}{\duedate}
    \covercell{125mm}{-12.4cm}{بارم}{\hwgrade{} نمره}

    \fill[mid] ([xshift=15mm, yshift=-14.6cm]current page.north west)
        rectangle ([xshift=-15mm, yshift=-14.65cm]current page.north east);

    \covercell{15mm}{-15.2cm}{استاد درس}{\lecturers}
    \covercell{125mm}{-15.2cm}{طراح تمرین}{\hwauthor}

    \fill[ink] ([xshift=15mm, yshift=-17.4cm]current page.north west)
        rectangle ([xshift=-15mm, yshift=-17.76cm]current page.north east);

    % ── Foot: full-bleed black block ───────────────────────────────────
    \fill[ink] (current page.south west) rectangle
               ([yshift=4cm]current page.south east);
    \node[anchor=east, text=paper, xshift=-15mm, yshift=2.6cm]
        at (current page.south east)
        {\rl{\postfont\fontsize{26}{30}\selectfont اول قواعد را بخوانید.}};
    \node[anchor=east, text=paper, xshift=-15mm, yshift=1.3cm, text width=12cm,
          font=\small, align=right]
        at (current page.south east)
        {\rl{قالب تحویل، سیاست تأخیر و قواعد امانت‌داری علمی در صفحه‌ی بعد
             آمده است. هرچه آنجا نیامده باشد با نظر استاد درس تعیین می‌شود.}};
    \node[anchor=west, text=paper, xshift=15mm, yshift=1.9cm]
        at (current page.south west)
        {\rl{\postfont\fontsize{40}{40}\selectfont \hwgrade}};

\end{tikzpicture}
\end{titlepage}
\setcounter{page}{1}
}

\endinput
