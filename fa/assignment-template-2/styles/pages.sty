\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pages}[2026/08/03 Full-width footer]

\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\RequirePackage{tikz}
\tcbuselibrary{skins}

\AtBeginDocument{
    \ifdefined\geometry
        \geometry{a4paper, margin=1.5cm, footskip=1.2cm}
    \fi
}

\newcommand{\neofooter}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
    
    \fancyfoot[CE, CO]{
        \begin{tikzpicture}[remember picture, overlay]
            \fill[ink] (current page.south west) rectangle ([yshift=25pt]current page.south east);
            
            \ifodd\value{page}
                \node[anchor=west, xshift=1.5cm, yshift=12.5pt] at (current page.south west) {
                    \small\color{paper}{\bfseries \ifdefined\semester \rl{\semester} \fi}
                };
                \node[anchor=east, xshift=-1.5cm, yshift=12.5pt] at (current page.south east) {
                    \small\color{paper}{\pixelfont \thepage}
                };
            \else
                \node[anchor=west, xshift=1.5cm, yshift=12.5pt] at (current page.south west) {
                    \small\color{paper}{\pixelfont \thepage}
                };
                \node[anchor=east, xshift=-1.5cm, yshift=12.5pt] at (current page.south east) {
                    \small\color{paper}{\bfseries \ifdefined\hwtitle \rl{\hwtitle} \fi}
                };
            \fi
        \end{tikzpicture}
    }
}

\fancypagestyle{neostyle}{\neofooter}
\fancypagestyle{plain}{\neofooter}
\pagestyle{neostyle}